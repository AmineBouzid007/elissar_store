# --- Base de données (Postgres : Neon, Supabase, Vercel Postgres...) ---
# Sur Vercel : Storage -> Create Database -> Neon -> connecter au projet (DATABASE_URL est ajouté automatiquement).
DATABASE_URL=

# --- Connexion admin (/admin) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long
# chaîne aléatoire de 32+ caractères :  openssl rand -base64 32
AUTH_SECRET=

# --- Optionnel : upload des photos produits depuis l'admin (Vercel Storage -> Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Optionnel : URL publique du site (SEO) ---
NEXT_PUBLIC_SITE_URL=https://www.elissar.tn

# --- Paiement en ligne par carte ---
# none      = paiement à la livraison uniquement (défaut)
# mock      = fausse page de paiement pour tester (refusée en production Vercel, sauf ALLOW_MOCK_PAYMENTS=true)
# clictopay = ClicToPay (nécessite le contrat bancaire + identifiants de test/production de la banque)
PAYMENT_PROVIDER=none
# À mettre à true seulement pour faire une démo du faux paiement sur le site en ligne :
ALLOW_MOCK_PAYMENTS=
# ClicToPay — fournis par la banque (d'abord l'environnement de test, puis la production) :
CLICTOPAY_USERNAME=
CLICTOPAY_PASSWORD=
CLICTOPAY_BASE_URL=
# Optionnel : adresse publique utilisée pour le retour depuis la banque (sinon déduite de la requête)
PAYMENT_RETURN_BASE_URL=
# Optionnel : minutes avant d'annuler une commande carte non payée et de remettre le stock (défaut 45, minimum 5).
# Doit rester plus long que la durée de session de la page de paiement de la banque.
CARD_ORDER_EXPIRY_MINUTES=45
# Optionnel : protège /api/payments/reconcile (appelé avec "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
